version: '3.8'
services:
  mongodb:
    image: mongo:8.2.3-noble
    container_name: lmtt-db
    restart: unless-stopped
    ports:
      - '${MONGO_DB_PORT}:${MONGO_DB_PORT}'
    env_file:
      - path: ../.env
        required: true
    environment:
      MONGO_INITDB_ROOT_USERNAME: ${MONGO_DB_USERNAME}
      MONGO_INITDB_ROOT_PASSWORD: ${MONGO_DB_PASSWORD}
      MONGO_INITDB_DATABASE: ${MONGO_DB_NAME}
    volumes:
      - mongodb_data:/data/db
      - ./mongodb/logs:/var/log/mongodb
    networks:
      - lmtt-network
    healthcheck:
      test: ['CMD', 'mongosh', '--eval', "db.adminCommand('ping')"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

  lmtt-app:
    image: node:24.13.0-alpine
    build:
      context: .
      dockerfile: Dockerfile-lmtt-app
    container_name: lmtt-app
    restart: unless-stopped
    ports:
      - ${APP_PORT}:${APP_PORT}
    env_file:
      - path: ../.env
        required: true
    environment:
      - APP_PORT=${APP_PORT}
      - MONGO_DB_HOSTNAME=${MONGO_DB_HOSTNAME}
      - MONGO_DB_PORT=${MONGO_DB_PORT}
      - MONGO_DB_NAME=${MONGO_DB_NAME}
      - MONGO_DB_USERNAME=${MONGO_DB_USERNAME}
      - MONGO_DB_PASSWORD=${MONGO_DB_PASSWORD}
      - SWAGGER_COMPANY_NAME=${SWAGGER_COMPANY_NAME}
      - SWAGGER_COMPANY_SITE=${SWAGGER_COMPANY_SITE}
      - SWAGGER_COMPANY_EMAIL=${SWAGGER_COMPANY_EMAIL}
      - MONGODB_DB_NAME=${MONGO_DB_NAME}
      - SCHEDULES_CONF_FILE_NAME=${SCHEDULES_CONF_FILE_NAME}
      - NODE_ENV=production
    volumes:
      - ./lmtt-data:/app/lmtt-data
      # - ./schedules.json:/app/schedules.json
    networks:
      - lmtt-network
    depends_on:
      mongodb:
        condition: service_healthy
    command: ['npm', 'run', 'start:prod']

volumes:
  mongodb_data:

networks:
  lmtt-network:
    driver: bridge
