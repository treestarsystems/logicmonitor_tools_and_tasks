version: '3.8'
services:
  mongodb:
    build:
      context: .
      dockerfile: Dockerfile-lmtt-db
    image: docker.io/mongodb/mongodb-community-server:4.4-ubuntu2204
    hostname: lmtt-db
    container_name: lmtt-db
    restart: unless-stopped
    ports:
      - '$MONGODB_PORT:$MONGODB_PORT'
    environment:
      TZ: America/New_York
#      MONGODB_INITDB_ROOT_USERNAME: $MONGODB_USERNAME
#      MONGODB_INITDB_ROOT_PASSWORD: $MONGODB_PASSWORD
      MONGODB_INITDB_DATABASE: $MONGODB_NAME
    volumes:
      - /opt/lmtt/db/logs:/var/log/mongodb:Z
      - /opt/lmtt/db/data:/data/db:Z
    networks:
      - lmtt-network
    command: /bin/bash -c 'mongod --config /etc/mongod.conf'
    healthcheck:
      test: ["CMD-SHELL", "mongo --eval 'db.runCommand({ ping: 1 })' || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
    deploy:
      resources:
        limits:
          memory: 512M
          cpus: "0.50"

  lmtt-app:
    build:
      context: .
      dockerfile: Dockerfile-lmtt-app
    hostname: lmtt-app
    container_name: lmtt-app
    restart: unless-stopped
    ports:
      - '$APP_PORT:$APP_PORT'
    environment:
      TZ: America/New_York
      APP_PORT: $APP_PORT
      MONGODB_HOSTNAME: lmtt-db
      MONGODB_PORT: $MONGODB_PORT
      MONGODB_NAME: $MONGODB_NAME
#      MONGODB_USERNAME: $MONGODB_USERNAME
#      MONGODB_PASSWORD: $MONGODB_PASSWORD
      SWAGGER_COMPANY_NAME: $SWAGGER_COMPANY_NAME
      SWAGGER_COMPANY_SITE: $SWAGGER_COMPANY_SITE
      SWAGGER_COMPANY_EMAIL: $SWAGGER_COMPANY_EMAIL
      SCHEDULES_CONF_FILE_NAME: $SCHEDULES_CONF_FILE_NAME
      NODE_ENV: production
    volumes:
      - /opt/lmtt/app/logs:/usr/src/app/lmtt-app-logs:Z
    networks:
      - lmtt-network
    depends_on:
      mongodb:
        condition: service_healthy
    healthcheck:
      test: ['CMD-SHELL', 'curl -s -f http://localhost:3000/api/v1/health/quick || exit 1']
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    deploy:
      resources:
        limits:
          memory: 128M
          cpus: "0.25"

volumes:
  mongodb_data:

networks:
  lmtt-network:
    driver: bridge
